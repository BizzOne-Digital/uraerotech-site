# Vercel: set these in Project → Settings → Environment Variables
# Frontend calls /api on the same domain — no VITE_API_URL needed

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/uraerotech
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
NODE_ENV=production

# Optional — auto-detected from VERCEL_URL if omitted
CLIENT_URL=https://uraerotech-eight.vercel.app

# Local development only
PORT=5000
VITE_SITE_URL=http://localhost:5173

# Cloudinary (optional — for admin image uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gmail SMTP (optional — contact/quote emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=UR Aerotech <your-email@gmail.com>
ADMIN_EMAIL=info@uraerotech.com

# Run once locally with production MONGODB_URI to populate the database:
# npm run seed
SEED_ADMIN_EMAIL=admin@uraerotech.com
SEED_ADMIN_PASSWORD=ChangeMe123!
